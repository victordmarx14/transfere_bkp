# Define o diretório dos arquivos
ARQ_BKP_DIR="$1"
IP="192.168.0.198"

while true; do 
    if gum spin --spinner dot --title "Testando conexão com $IP" -- ping -c 1 -W5 "$IP"; then
		arq=$(basename "$ARQ_BKP_DIR")
		echo "IP encontrado, copiando $arq"
		scp "$ARQ_BKP_DIR" backup@$IP:.
		echo "Cópia finalizada"

		echo "Desligando mini pc" ; ssh backup@192.168.0.198 "sudo shutdown" ; break

		#opcao=$(gum choose --header 'Deseja desligar o mini PC?' 'Sim' 'Não')

		#case "$opcao" in
		#	Sim) echo "Desligando mini pc" ; ssh backup@192.168.0.198 "sudo shutdown" ; break ;;
		#	Não) break ;;
		#esac

   else
		opcao=$(gum choose --header 'Sem resposta após 5 segundos, deseja testar novamente?' 'Sim' 'Não')

		case "$opcao" in
			Sim) continue ;;
			Não) echo "Encerrando" ; clear ; break ;;
		esac
   fi
done

while true; do
    if findmnt "/dev/sdc1" > /dev/null ; then # Verifica se o ponto de montagem existe
		avail=$(df -B1 /dev/sdc1 | awk {'print $4'} | tail -1) # armazena o espaço disponível em bytes
		file_size=$(stat -c%s "$ARQ_BKP_DIR") # armazena o tamanho do arquivo em bytes
		pendrive=$(df /dev/sdc1 | awk {'print $6'} | tail -1) # retorna o caminho onde está montado
		
		if (( avail > file_size )); then # valida se o espaço disponivel e maior que o tamanho do arquivo
			gum spin --spinner points --title "Espaço suficiente no pendrive, copiando arquivo" -- cp -v "$ARQ_BKP_DIR" "$pendrive/bkp_completo" # exibe mensagem e copia o arquivo
			gum style \
				--foreground 2 \
				--border-foreground 2 \
				--border double \
				--align center \
				--width 50 \
				--margin "1 2" \
				--padding "1" \
				"✅ Cópia concluída" # exibe mensagem de sucesso na copia
			exit 0 # encerra com codigo de sucesso

		else
			arq=$(ls -t $pendrive/bkp_completo | tail -1) # encontra o arquivo mais antigo do pendrive

			gum spin --spinner pulse --title "Espaço insuficiente, removendo arquivo $arq" -- rm -f "$pendrive/bkp_completo/$arq" # exibe mensagem de espaço insuficiente e arquivo que será removido e executa a remoçao do arquivo. Prossegue na execuçao do loop, voltando para a validaçao anterior
			gum style \
				--foreground 2 \
				--border-foreground 2 \
				--border double \
				--align center \
				--width 50 \
				--margin "1 2" \
				--padding "1" \
				"✅ Remoção de $arq concluída"

			#opcao=$(gum choose --header "Espaço insuficiente, remover backup mais antigo? $(basename $arq)" 'Sim' 'Não')
			
			#case "$opcao" in
			#	Sim) gum spin --spinner pulse --title "Removendo arquivo" -- rm -f "$pendrive/bkp_completo/$arq" ; continue ;;
			#	Não) echo "Encerrando" ; exit 1 ;;
			#esac
		fi
    else
		opcao=$(gum choose --header 'Pendrive não encontrado, deseja testar novamente?' 'Sim' 'Não') # se o pendrive não for encontrado, exibe mensagem e permite selecionar como prosseguir

		case "$opcao" in
			Sim) continue ;; # se for selecionado Sim, volta para o inicio do loop
			Não) echo "Encerrando" ; exit 1 ;; # se for selecionado Não, encerra com código de erro genérico
		esac
    fi
done

	    
	   
